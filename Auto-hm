local currentTarget = nil

local function isTeammate(otherPlayer)
	if otherPlayer == player then return true end
	if player.Team and otherPlayer.Team and player.Team == otherPlayer.Team then return true end
	if otherPlayer:GetAttribute("Team") and player:GetAttribute("Team") and otherPlayer:GetAttribute("Team") == player:GetAttribute("Team") then return true end
	if otherPlayer.TeamColor and player.TeamColor and otherPlayer.TeamColor == player.TeamColor then return true end
	return false
end

-- Raycast ULTRA PRECISO anti-coberturas / paredes
local function hasLineOfSight(fromPos, toPos, characterToIgnore)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {player.Character, characterToIgnore}
	raycastParams.IgnoreWater = true
	
	local direction = toPos - fromPos
	local result = Workspace:Raycast(fromPos, direction, raycastParams)
	
	if result then
		local hitPart = result.Instance
		-- Si choca con una parte que NO pertenece al objetivo (ej. una pared, piso, objeto del mapa)
		if not hitPart:IsDescendantOf(characterToIgnore) then
			return false 
		end
	end
	
	return true
end

-- Búsqueda ultra rápida
task.spawn(function()
	while gui.Parent do
		task.wait(0.04) 
		if not enabled then
			currentTarget = nil
			continue
		end

		local char = player.Character
		if not char then continue end
		
		local tool = char:FindFirstChildOfClass("Tool")
		if not tool then
			currentTarget = nil
			continue
		end

		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		local myPos = root.Position + Vector3.new(0, 2, 0)
		local maxRange = 150
		local bestTarget = nil
		local bestDist = math.huge

		-- 1. Buscar Jugadores Enemigos con visión limpia obligatoria
		for _, v in ipairs(Players:GetPlayers()) do
			if not isTeammate(v) and v.Character then
				local tr = v.Character:FindFirstChild("HumanoidRootPart")
				local hum = v.Character:FindFirstChild("Humanoid")
				
				if tr and hum and hum.Health > 0 then
					local dist = (myPos - tr.Position).Magnitude
					if dist <= maxRange and math.abs(myPos.Y - tr.Position.Y) < 40 then
						if hasLineOfSight(myPos, tr.Position + Vector3.new(0, 2, 0), v.Character) then
							if dist < bestDist then
								bestDist = dist
								bestTarget = tr
							end
						end
					end
				end
			end
		end

		-- 2. Buscar NPCs / Bots con visión limpia obligatoria
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				local tr = obj:FindFirstChild("HumanoidRootPart")
				
				local isAllyNpc = false
				if obj:GetAttribute("Team") and player:GetAttribute("Team") and obj:GetAttribute("Team") == player:GetAttribute("Team") then
					isAllyNpc = true
				end
				
				if not isAllyNpc and hum and tr and hum.Health > 0 then
					local dist = (myPos - tr.Position).Magnitude
					if dist <= maxRange and math.abs(myPos.Y - tr.Position.Y) < 40 then
						if hasLineOfSight(myPos, tr.Position + Vector3.new(0, 2, 0), obj) then
							if dist < bestDist then
								bestDist = dist
								bestTarget = tr
							end
						end
					end
				end
			end
		end

		currentTarget = bestTarget
	end
end)

-- Movimiento ULTRA INTELIGENTE (Freno instantáneo si se oculta tras una pared)
RunService.RenderStepped:Connect(function()
	if not gui.Parent or not enabled then return end

	local char = player.Character
	if not char then return end
	
	local hum = char:FindFirstChild("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	local tool = char:FindFirstChildOfClass("Tool")
	
	if not hum or not root or not tool then return end

	if currentTarget and currentTarget.Parent then
		local targetModel = currentTarget.Parent
		local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
		
		-- Si muere o desaparece, limpiar al instante
		if not targetHum or targetHum.Health <= 0 or not currentTarget.Parent then
			currentTarget = nil
			hum:Move(Vector3.new(0, 0, 0))
			return
		end

		local targetPos = currentTarget.Position
		local myHeadPos = root.Position + Vector3.new(0, 2, 0)
		local targetHeadPos = targetPos + Vector3.new(0, 2, 0)

		-- INTELIGENCIA MAX: Validación por fotograma en tiempo real. 
		-- Si el jugador se esconde detrás de una pared, se borra el objetivo al instante y frena por completo.
		if not hasLineOfSight(myHeadPos, targetHeadPos, targetModel) then
			currentTarget = nil
			hum:Move(Vector3.new(0, 0, 0))
			return
		end

		local heightDifference = root.Position.Y - targetPos.Y
		local horizontalDist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude

		if heightDifference > 3.5 and horizontalDist < 3 then
			local safePos = targetPos + Vector3.new(3, 0, 3)
			hum:MoveTo(safePos)
		else
			hum:MoveTo(targetPos)
		end
	else
		hum:Move(Vector3.new(0, 0, 0))
	end
end)
